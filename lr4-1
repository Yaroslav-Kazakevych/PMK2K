#include "project.h"

// 1. Масив кодів для індикатора (Спільний анод)
// Індекси: 0-9 (цифри), 10 (A), 11 (b), 12 (C), 13 (d), 14 (E), 15 (F)
uint8_t LED_NUM[] = {
    0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90, // 0-9
    0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E                          // A, b, C, d, E, F
};

uint8_t keys[4][3]; // Матриця станів кнопок
uint8_t last_state = 255; // Для відстеження натискання

// 2. Функції роботи зі зсувним регістром (згідно з методичкою)
void FourDigit74HC595_sendData(uint8_t data) {
    for (uint8_t i = 0; i < 8; i++) {
        // Виставляємо біт даних (починаючи зі старшого)
        Pin_DO_Write((data & (0x80 >> i)) ? 1 : 0);
        // Тактовий імпульс зсуву
        Pin_CLK_Write(1);
        Pin_CLK_Write(0);
    }
}

void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit_index) {
    // Вибір розряду (позиції) - зазвичай інвертований сигнал для 4-х розрядів
    FourDigit74HC595_sendData(0xFF & ~(1 << position));
    // Вивід символу
    FourDigit74HC595_sendData(LED_NUM[digit_index]);
    
    // Защіпка (Latch)
    Pin_Latch_Write(1);
    Pin_Latch_Write(0);
}

// 3. Сканування матричної клавіатури
void readMatrix() {
    for (int col = 0; col < 3; col++) {
        // Активуємо колонку (Strong Drive, рівень 0)
        if (col == 0) { COLUMN_0_SetDriveMode(COLUMN_0_DM_STRONG); COLUMN_0_Write(0); }
        if (col == 1) { COLUMN_1_SetDriveMode(COLUMN_1_DM_STRONG); COLUMN_1_Write(0); }
        if (col == 2) { COLUMN_2_SetDriveMode(COLUMN_2_DM_STRONG); COLUMN_2_Write(0); }

        // Зчитуємо кожен рядок
        keys[0][col] = ROW_0_Read();
        keys[1][col] = ROW_1_Read();
        keys[2][col] = ROW_2_Read();
        keys[3][col] = ROW_3_Read();

        // Повертаємо колонку в High-Z
        if (col == 0) { COLUMN_0_SetDriveMode(COLUMN_0_DM_DIG_HIZ); }
        if (col == 1) { COLUMN_1_SetDriveMode(COLUMN_1_DM_DIG_HIZ); }
        if (col == 2) { COLUMN_2_SetDriveMode(COLUMN_2_DM_DIG_HIZ); }
    }
}

int main(void) {
    CyGlobalIntEnable;
    
    for(;;) {
        readMatrix();
        
        // Рядок 0: Кнопки 1, 2, 3
        if (keys[0][0] == 0 && last_state != 1) { last_state = 1; FourDigit74HC595_sendOneDigit(0, 1); }
        else if (keys[0][1] == 0 && last_state != 2) { last_state = 2; FourDigit74HC595_sendOneDigit(0, 2); }
        else if (keys[0][2] == 0 && last_state != 3) { last_state = 3; FourDigit74HC595_sendOneDigit(0, 3); }
        
        // Рядок 1: Кнопки 4, 5, 6
        else if (keys[1][0] == 0 && last_state != 4) { last_state = 4; FourDigit74HC595_sendOneDigit(0, 4); }
        else if (keys[1][1] == 0 && last_state != 5) { last_state = 5; FourDigit74HC595_sendOneDigit(0, 5); }
        else if (keys[1][2] == 0 && last_state != 6) { last_state = 6; FourDigit74HC595_sendOneDigit(0, 6); }
        
        // Рядок 3 (Нижній): кнопки *, 0, #
        // Завдання: кнопки * та # виводять літери (наприклад A та B)
        else if (keys[3][0] == 0 && last_state != 10) { // Кнопка *
            last_state = 10; 
            FourDigit74HC595_sendOneDigit(0, 10); // Вивід 'A'
        }
        else if (keys[3][1] == 0 && last_state != 0) { // Кнопка 0
            last_state = 0; 
            FourDigit74HC595_sendOneDigit(0, 0); 
        }
        else if (keys[3][2] == 0 && last_state != 11) { // Кнопка #
            last_state = 11; 
            FourDigit74HC595_sendOneDigit(0, 11); // Вивід 'b'
        }

        // Скидання стану, якщо кнопку відпущено (за потреби)
        if (keys[0][0] && keys[0][1] && keys[0][2] && keys[1][0] && keys[1][1] && keys[1][2] && 
            keys[2][0] && keys[2][1] && keys[2][2] && keys[3][0] && keys[3][1] && keys[3][2]) {
            last_state = 255;
        }
        
        CyDelay(50); // Невелика затримка для стабільності
    }
}
