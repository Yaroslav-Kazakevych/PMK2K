#include "project.h"

// Розмірність матриці тепер 4x4
#define ROWS 4
#define COLS 4

// Масив символів для 7-сегментного дисплея (спільний анод)
static uint8_t LED_NUM[] = {
    0xC0, // 0 (індекс 0)
    0xF9, // 1
    0xA4, // 2
    0xB0, // 3
    0x99, // 4
    0x92, // 5
    0x82, // 6
    0xF8, // 7
    0x80, // 8
    0x90, // 9 (індекс 9)
    0xBF, // - (індекс 10)
    0x88, // A (індекс 11)
    0x83, // b (індекс 12)
    0xC6, // C (індекс 13)
    0xA1, // d (індекс 14)
    0x86, // E (індекс 15)
    0x8E, // F (індекс 16)
    0x7F  // . (індекс 17)
};

// Карта клавіш 4x4: цифри та літери A-F
static const uint8_t key_map[ROWS][COLS] = {
    {1,  2,  3,  11}, // 1, 2, 3, A (11 - індекс 'A' в LED_NUM)
    {4,  5,  6,  12}, // 4, 5, 6, b (12 - індекс 'b')
    {7,  8,  9,  13}, // 7, 8, 9, C (13 - індекс 'C')
    {14, 0,  15, 16}  // d, 0, E, F (14-'d', 15-'E', 16-'F')
};

static uint8_t keys[ROWS][COLS];      
static uint8_t last_keys[ROWS][COLS]; 

// --- Керування 74HC595 ---
static void FourDigit74HC595_sendData(uint8_t data) {
    for(uint8_t i = 0; i < 8; i++) {
        Pin_DO_Write((data & (0x80 >> i)) ? 1 : 0);
        Pin_CLK_Write(1);
        Pin_CLK_Write(0);
    }
}

static void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit_index, uint8_t dot) {
    if(position >= 4) return;
    
    FourDigit74HC595_sendData(0xFF & ~(1 << position));
    uint8_t pattern = LED_NUM[digit_index];
    if(dot) pattern &= 0x7F; 
    
    FourDigit74HC595_sendData(pattern);
    Pin_Latch_Write(1);
    Pin_Latch_Write(0);
}

// --- Обгортки для пінів (Додано COLUMN_3) ---
static void setColumnDriveMode(uint8_t col, uint8_t mode) {
    switch(col) {
        case 0: COLUMN_0_SetDriveMode(mode); break;
        case 1: COLUMN_1_SetDriveMode(mode); break;
        case 2: COLUMN_2_SetDriveMode(mode); break;
        case 3: COLUMN_3_SetDriveMode(mode); break; // Додано для 4-ї колонки
    }
}

static void setColumnWrite(uint8_t col, uint8_t value) {
    switch(col) {
        case 0: COLUMN_0_Write(value); break;
        case 1: COLUMN_1_Write(value); break;
        case 2: COLUMN_2_Write(value); break;
        case 3: COLUMN_3_Write(value); break; // Додано для 4-ї колонки
    }
}

static uint8_t readRow(uint8_t row) {
    switch(row) {
        case 0: return ROW_0_Read();
        case 1: return ROW_1_Read();
        case 2: return ROW_2_Read();
        case 3: return ROW_3_Read();
        default: return 1;
    }
}

// --- Логіка матриці ---
static void initMatrix() {
    for(int c = 0; c < COLS; c++) {
        setColumnDriveMode(c, COLUMN_0_DM_DIG_HIZ);
    }
    for(int r = 0; r < ROWS; r++) {
        for(int c = 0; c < COLS; c++) {
            last_keys[r][c] = 1; 
        }
    }
}

static void readMatrix() {
    for(int c = 0; c < COLS; c++) {
        setColumnDriveMode(c, COLUMN_0_DM_STRONG);
        setColumnWrite(c, 0); 
        
        for(int r = 0; r < ROWS; r++) {
            keys[r][c] = readRow(r); 
        }
        
        setColumnWrite(c, 1);
        setColumnDriveMode(c, COLUMN_0_DM_DIG_HIZ);
    }
}

int main(void) {
    CyGlobalIntEnable;
    SW_Tx_UART_Start();
    initMatrix();
    
    FourDigit74HC595_sendOneDigit(0, 10, 0); // Прочерк при старті
    
    for(;;) {
        readMatrix();
        
        for(int r = 0; r < ROWS; r++) {
            for(int c = 0; c < COLS; c++) {
                
                // Обробка натискання
                if(keys[r][c] == 0 && last_keys[r][c] == 1) {
                    uint8_t val = key_map[r][c]; // Отримуємо індекс з мапи (0-16)
                    
                    // Відображаємо символ (включаючи A-F)
                    FourDigit74HC595_sendOneDigit(0, val, 0);
                    
                    SW_Tx_UART_PutString("Key: ");
                    SW_Tx_UART_PutHexInt(val);
                    SW_Tx_UART_PutCRLF();
                    
                    LED_R_Write(0); 
                    LED_G_Write(0);
                    LED_B_Write(0);
                }
                
                if(keys[r][c] == 1 && last_keys[r][c] == 0) {
                    LED_R_Write(1); 
                    LED_G_Write(1);
                    LED_B_Write(1);
                }
                last_keys[r][c] = keys[r][c]; 
            }
        }
        CyDelay(25); 
    }
}
