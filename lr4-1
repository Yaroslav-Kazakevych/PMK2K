[span_12](start_span)[span_13](start_span)// Функція відправки одного байту даних на зсувний регістр[span_12](end_span)[span_13](end_span)
static void FourDigit74HC595_sendData(uint8_t data) {
    for (uint8_t i = 0; i < 8; i++) {
        if (data & (0x80 >> i)) {
            Pin_DO_Write(1);
        } else {
            Pin_DO_Write(0);
        }
        Pin_CLK_Write(1);
        Pin_CLK_Write(0);
    }
}

