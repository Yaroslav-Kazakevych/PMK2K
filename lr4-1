static uint8_t keys[4][3];
static void (*COLUMN_x_SetDriveMode[3])(uint8_t mode) = { COLUMN_0_SetDriveMode, COLUMN_1_SetDriveMode, COLUMN_2_SetDriveMode };
static void (*COLUMN_x_Write[3])(uint8_t value) = { COLUMN_0_Write, COLUMN_1_Write, COLUMN_2_Write };
static uint8 (*ROW_x_Read[4])() = { ROW_0_Read, ROW_1_Read, ROW_2_Read, ROW_3_Read };

void readMatrix() {
    for (int col = 0; col < 3; col++) {
        COLUMN_x_SetDriveMode[col](COLUMN_0_DM_STRONG);
        COLUMN_x_Write[col](0);
        for (int row = 0; row < 4; row++) {
            keys[row][col] = ROW_x_Read[row]();
        }
        COLUMN_x_SetDriveMode[col](COLUMN_0_DM_DIG_HIZ);
    }
}

int main(void) {
    CyGlobalIntEnable;
    SW_Tx_UART_Start();
    
    uint8_t last_button = 255; // Змінна для відстеження стану

    for(;;) {
        readMatrix();
        
        [cite_start]// Перевірка натискання кнопок 1-3 (Ряд 0) [cite: 163-172]
        if (keys[0][0] == 0 && last_button != 1) { // Кнопка 1
            FourDigit74HC595_sendOneDigit(0, 1, 0);
            last_button = 1;
        } 
        else if (keys[0][1] == 0 && last_button != 2) { // Кнопка 2
            FourDigit74HC595_sendOneDigit(0, 2, 0);
            last_button = 2;
        }
        else if (keys[0][2] == 0 && last_button != 3) { // Кнопка 3
            FourDigit74HC595_sendOneDigit(0, 3, 0);
            last_button = 3;
        }
        [cite_start]// Аналогічно для кнопок 4-6 (Ряд 1) та 7-9 (Ряд 2) [cite: 173-192]
        
        [cite_start]// Приклад виведення літер (наприклад, кнопка '*' виводить 'A')[span_20](end_span)[span_21](end_span)
        else if (keys[3][0] == 0 && last_button != 10) { 
            FourDigit74HC595_sendOneDigit(0, 11, 0); // 11 індекс у LED_NUM — це 'A'
            last_button = 10;
        }
        
        // Якщо всі кнопки відпущені (спрощена логіка скидання стану)
        if (keys[0][0] && keys[0][1] && keys[0][2] && keys[3][0]) {
            last_button = 255;
        }
    }
}
