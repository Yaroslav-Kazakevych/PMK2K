#include "project.h"

// Масив для семисегментного індикатора (Спільний анод)
// 0-9, потім A, b, C, d, E, F
uint8_t LED_NUM[] = {
    0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90, // 0-9
    0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E                          // A, b, C, d, E, F
};

uint8_t keys[4][3];
uint8_t last_button = 255;

// Прототипи функцій
void FourDigit74HC595_sendData(uint8_t data);
void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit_index);
void readMatrix(void);

// Функція передачі байта
void FourDigit74HC595_sendData(uint8_t data) {
    for (uint8_t i = 0; i < 8; i++) {
        if (data & (0x80 >> i)) Pin_DO_Write(1);
        else Pin_DO_Write(0);
        
        Pin_CLK_Write(1);
        Pin_CLK_Write(0);
    }
}

// Функція виводу на розряд
void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit_index) {
    // Вибір позиції (розряду)
    FourDigit74HC595_sendData(0xFF & ~(1 << position));
    // Вивід коду символу
    FourDigit74HC595_sendData(LED_NUM[digit_index]);
    
    Pin_Latch_Write(1);
    Pin_Latch_Write(0);
}

// Сканування матриці клавіатури 4х3
void readMatrix(void) {
    // Сканування колонки 0
    COLUMN_0_SetDriveMode(COLUMN_0_DM_STRONG);
    COLUMN_0_Write(0);
    keys[0][0] = ROW_0_Read(); keys[1][0] = ROW_1_Read();
    keys[2][0] = ROW_2_Read(); keys[3][0] = ROW_3_Read();
    COLUMN_0_SetDriveMode(COLUMN_0_DM_DIG_HIZ);

    // Сканування колонки 1
    COLUMN_1_SetDriveMode(COLUMN_1_DM_STRONG);
    COLUMN_1_Write(0);
    keys[0][1] = ROW_0_Read(); keys[1][1] = ROW_1_Read();
    keys[2][1] = ROW_2_Read(); keys[3][1] = ROW_3_Read();
    COLUMN_1_SetDriveMode(COLUMN_1_DM_DIG_HIZ);

    // Сканування колонки 2
    COLUMN_2_SetDriveMode(COLUMN_2_DM_STRONG);
    COLUMN_2_Write(0);
    keys[0][2] = ROW_0_Read(); keys[1][2] = ROW_1_Read();
    keys[2][2] = ROW_2_Read(); keys[3][2] = ROW_3_Read();
    COLUMN_2_SetDriveMode(COLUMN_2_DM_DIG_HIZ);
}

int main(void) {
    CyGlobalIntEnable;

    for(;;) {
        readMatrix();

        // Обробка натискання (приклад для кількох кнопок)
        
        // Кнопка '1'
        if (keys[0][0] == 0 && last_button != 1) {
            FourDigit74HC595_sendOneDigit(0, 1);
            last_button = 1;
        }
        // Кнопка '2'
        else if (keys[0][1] == 0 && last_button != 2) {
            FourDigit74HC595_sendOneDigit(0, 2);
            last_button = 2;
        }
        // Кнопка '*' (виводимо 'A' за методичкою)
        else if (keys[3][0] == 0 && last_button != 10) {
            FourDigit74HC595_sendOneDigit(0, 10); // 10-й індекс — це 'A'
            last_button = 10;
        }
        // Кнопка '0'
        else if (keys[3][1] == 0 && last_button != 0) {
            FourDigit74HC595_sendOneDigit(0, 0);
            last_button = 0;
        }
        // Кнопка '#' (виводимо 'b')
        else if (keys[3][2] == 0 && last_button != 11) {
            FourDigit74HC595_sendOneDigit(0, 11); // 11-й індекс — це 'b'
            last_button = 11;
        }

        // Скидання стану, якщо кнопку відпущено
        if (keys[0][0] && keys[0][1] && keys[3][0] && keys[3][1] && keys[3][2]) {
            last_button = 255;
        }
        
        CyDelay(10); 
    }
}
