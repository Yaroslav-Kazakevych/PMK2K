#include "project.h"

// --- Matrix dimensions: 4 rows x 3 cols ---
#define ROWS 4
#define COLS 3

// 7-segment patterns (common anode)
static const uint8_t LED_NUM[] = {
    0xC0, // [0]  0
    0xF9, // [1]  1
    0xA4, // [2]  2
    0xB0, // [3]  3
    0x99, // [4]  4
    0x92, // [5]  5
    0x82, // [6]  6
    0xF8, // [7]  7
    0x80, // [8]  8
    0x90, // [9]  9
    0xBF, // [10] -
    0x88, // [11] A
    0x83, // [12] b
    0xC6, // [13] C
    0xA1, // [14] d
    0x86, // [15] E  ← новий
    0x8E  // [16] F  ← новий
};

// Normal key map: '*' (row3,col0) is now SHIFT — mapped to 0xFF (sentinel)
static const uint8_t key_map[ROWS][COLS] = {
    { 1,  2, 11}, // 1,  2,  A
    { 4,  5, 12}, // 4,  5,  b
    { 7,  8, 13}, // 7,  8,  C
    {0xFF, 0, 14} // *(SHIFT), 0, d
};

// Shift key map: only '1'→E, '2'→F differ; rest identical to key_map
static const uint8_t shift_key_map[ROWS][COLS] = {
    {15, 16, 11}, // E,  F,  A
    { 4,  5, 12}, // 4,  5,  b
    { 7,  8, 13}, // 7,  8,  C
    {0xFF, 0, 14} // *(SHIFT), 0, d
};

static uint8_t keys[ROWS][COLS];
static uint8_t last_keys[ROWS][COLS];
static uint8_t shift_mode = 0; // 0=normal, 1=shift active

// ── 74HC595 ──────────────────────────────────────────────────────────────────

static void FourDigit74HC595_sendData(uint8_t data) {
    for (uint8_t i = 0; i < 8; i++) {
        Pin_DO_Write((data & (0x80 >> i)) ? 1 : 0);
        Pin_CLK_Write(1);
        Pin_CLK_Write(0);
    }
}

static void FourDigit74HC595_sendOneDigit(uint8_t position,
                                          uint8_t digit_index,
                                          uint8_t dot) {
    if (position >= 4) {
        FourDigit74HC595_sendData(0xFF);
        FourDigit74HC595_sendData(0xFF);
        return;
    }
    FourDigit74HC595_sendData(0xFF & ~(1u << position));
    uint8_t pattern = LED_NUM[digit_index];
    if (dot) pattern &= 0x7F; // увімкнути крапку (active-low)
    FourDigit74HC595_sendData(pattern);
    Pin_Latch_Write(1);
    Pin_Latch_Write(0);
}

// ── Pin wrappers ──────────────────────────────────────────────────────────────

static void setColumnDriveMode(uint8_t col, uint8_t mode) {
    switch (col) {
        case 0: COLUMN_0_SetDriveMode(mode); break;
        case 1: COLUMN_1_SetDriveMode(mode); break;
        case 2: COLUMN_2_SetDriveMode(mode); break;
    }
}

static void setColumnWrite(uint8_t col, uint8_t value) {
    switch (col) {
        case 0: COLUMN_0_Write(value); break;
        case 1: COLUMN_1_Write(value); break;
        case 2: COLUMN_2_Write(value); break;
    }
}

static uint8_t readRow(uint8_t row) {
    switch (row) {
        case 0: return ROW_0_Read();
        case 1: return ROW_1_Read();
        case 2: return ROW_2_Read();
        case 3: return ROW_3_Read();
        default: return 1;
    }
}

// ── Matrix logic ──────────────────────────────────────────────────────────────

static void initMatrix(void) {
    for (int c = 0; c < COLS; c++) {
        setColumnDriveMode(c, COLUMN_0_DM_DIG_HIZ);
    }
    for (int r = 0; r < ROWS; r++) {
        for (int c = 0; c < COLS; c++) {
            last_keys[r][c] = 1;
        }
    }
}

static void readMatrix(void) {
    for (int c = 0; c < COLS; c++) {
        setColumnDriveMode(c, COLUMN_0_DM_STRONG);
        setColumnWrite(c, 0);
        for (int r = 0; r < ROWS; r++) {
            keys[r][c] = readRow(r);
        }
        setColumnWrite(c, 1);
        setColumnDriveMode(c, COLUMN_0_DM_DIG_HIZ);
    }
}

// ── Main ──────────────────────────────────────────────────────────────────────

int main(void) {
    CyGlobalIntEnable;

    SW_Tx_UART_Start();
    initMatrix();

    // Initial display: show '-' without dot
    FourDigit74HC595_sendOneDigit(0, 10, 0);

    SW_Tx_UART_PutString("System Ready. Scan 4x3 matrix...\r\n");
    SW_Tx_UART_PutString("[*] = SHIFT: 1->E, 2->F (dot = shift active)\r\n");

    for (;;) {
        readMatrix();

        for (int r = 0; r < ROWS; r++) {
            for (int c = 0; c < COLS; c++) {

                // ── Rising edge: key pressed ──────────────────────────────
                if (keys[r][c] == 0 && last_keys[r][c] == 1) {

                    // Shift key: row 3, col 0
                    if (r == 3 && c == 0) {
                        shift_mode ^= 1; // toggle

                        // Відображаємо поточний символ з крапкою/без
                        // (ми не знаємо, що було раніше, тому показуємо '-'
                        //  зі станом shift як індикатор)
                        FourDigit74HC595_sendOneDigit(0, 10, shift_mode);

                        SW_Tx_UART_PutString("SHIFT ");
                        SW_Tx_UART_PutString(shift_mode ? "ON\r\n" : "OFF\r\n");

                        LED_R_Write(shift_mode ? 0 : 1); // синій = shift on
                        LED_G_Write(1);
                        LED_B_Write(shift_mode ? 1 : 0);

                    } else {
                        // Звичайна клавіша
                        uint8_t val = shift_mode
                                    ? shift_key_map[r][c]
                                    : key_map[r][c];

                        // Відображаємо з крапкою, якщо shift активний
                        FourDigit74HC595_sendOneDigit(0, val, shift_mode);

                        SW_Tx_UART_PutString("Key: 0x");
                        SW_Tx_UART_PutHexInt(val);
                        if (shift_mode) SW_Tx_UART_PutString(" [SHIFT]");
                        SW_Tx_UART_PutCRLF();

                        LED_R_Write(0);
                        LED_G_Write(0);
                        LED_B_Write(0);
                    }
                }

                // ── Falling edge: key released ────────────────────────────
                if (keys[r][c] == 1 && last_keys[r][c] == 0) {
                    if (!(r == 3 && c == 0)) { // не shift-клавіша
                        LED_R_Write(1);
                        LED_G_Write(1);
                        LED_B_Write(1);
                    }
                }

                last_keys[r][c] = keys[r][c];
            }
        }

        CyDelay(25);
    }
}