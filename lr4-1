#include "project.h"

// 1. Таблиця відповідності двійкових кодів (Спільний анод)
// Додано символи A, b, C, d, E, F (індекси 10-15)
static uint8_t LED_NUM[] = {
    0xC0, // 0
    0xF9, // 1
    0xA4, // 2
    0xB0, // 3
    0x99, // 4
    0x92, // 5
    0x82, // 6
    0xF8, // 7
    0x80, // 8
    0x90, // 9
    0x88, // A
    0x83, // b
    0xC6, // C
    0xA1, // d
    0x86, // E
    0x8E, // F
    0x7F  // . (крапка)
};

// 2. Функція відправки одного байту на зсувний регістр (Рис. 10)
static void FourDigit74HC595_sendData(uint8_t data) {
    for(uint8_t i = 0; i < 8; i++) {
        // Виділяємо кожен біт, починаючи зі старшого (MSB)
        if(data & (0x80 >> i)) {
            Pin_DO_Write(1);
        } else {
            Pin_DO_Write(0);
        }
        // Тактовий імпульс
        Pin_CLK_Write(1);
        Pin_CLK_Write(0);
    }
}

// 3. Функція виводу одного символу на певну позицію (Рис. 11)
static void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit, uint8_t dot) {
    // Якщо позиція поза межами (4-розрядний дисплей), очищуємо
    if(position >= 4) {
        FourDigit74HC595_sendData(0xFF);
        FourDigit74HC595_sendData(0xFF);
    } else {
        // Відправляємо маску позиції (який розряд увімкнути)
        FourDigit74HC595_sendData(0xFF & ~(1 << position));
        
        // Відправляємо код символу з урахуванням крапки
        if(dot) {
            FourDigit74HC595_sendData(LED_NUM[digit] & 0x7F);
        } else {
            FourDigit74HC595_sendData(LED_NUM[digit]);
        }
    }
    
    // Защіпка (Latch) для відображення даних
    Pin_Latch_Write(1);
    Pin_Latch_Write(0);
}

/* ПРИМІТКА: Функція сканування матричної клавіатури залежить від вашої схеми.
   Нижче наведено приклад структури, яку вам потрібно адаптувати.
*/
uint8_t Get_Keypad_Number() {
    // Тут має бути ваш код сканування рядків та стовпців.
    // Наприклад, якщо натиснуто кнопку 'A', функція має повернути 10.
    // Якщо нічого не натиснуто — 0xFF.
    return 0xFF; 
}

int main(void) {
    CyGlobalIntEnable; /* Enable global interrupts. */

    uint8_t current_key = 0xFF;

    for(;;) {
        // 1. Опитуємо клавіатуру
        current_key = Get_Keypad_Number();

        // 2. Якщо клавішу натиснуто (код від 0 до 15)
        if (current_key <= 15) {
            // Виводимо символ на 0-ву позицію дисплея
            FourDigit74HC595_sendOneDigit(0, current_key, 0);
        }
        
        CyDelay(10); // Затримка для запобігання дребезгу
    }
}