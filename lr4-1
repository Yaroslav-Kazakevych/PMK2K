static void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit_index, uint8_t dot) {
    if (position >= 8) {
        FourDigit74HC595_sendData(0xFF);
        FourDigit74HC595_sendData(0xFF);
        return;
    }
    [span_16](start_span)[span_17](start_span)// Керування номером символу (позицією)[span_16](end_span)[span_17](end_span)
    FourDigit74HC595_sendData(0xFF & ~(1 << position));
    
    [span_18](start_span)[span_19](start_span)// Керування символом, що виводиться[span_18](end_span)[span_19](end_span)
    if (dot) {
        FourDigit74HC595_sendData(LED_NUM[digit_index] & 0x7F);
    } else {
        FourDigit74HC595_sendData(LED_NUM[digit_index]);
    }
    
    Pin_Latch_Write(1);
    Pin_Latch_Write(0);
}

